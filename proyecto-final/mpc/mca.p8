pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- programa pico-8 para reproducir mれむltiples pistas de mれむsica
function _init()
    current_track = 0
    max_tracks = 16 -- cambia esto a 15 si tienes 15 pistas
    play_next_track()
end

function play_next_track()
    if current_track < max_tracks then
        music(current_track)
        current_track += 1
    else
        current_track = 0
        music(-1) -- detener la mれむsica si todas las pistas han sido reproducidas
    end
end

function _update()
    if not stat(52) then -- si no hay mれむsica reproduciれたndose
        play_next_track()
    end
end

